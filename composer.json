{
  "name": "yireo/module-stock-management-cli",
  "version": "1.0.0",
  "description": "Manage the stock of products via the Magento CLI",
  "type": "magento2-module",
  "require": {
    "php": ">=8.1",
    "ext-pcre": "*",
    "magento/framework": "^103.0",
    "magento/module-catalog": "^104.0",
    "magento/module-catalog-inventory": "^100.4",
    "symfony/console": "^5.0 || ^6.0 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.5"
  },
  "suggest": {
    "magento/module-inventory-api": "Allows updating the quantity of MSI sources with --source"
  },
  "license": [
    "OSL-3.0"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Yireo\\StockManagementCli\\": ""
    }
  }
}
